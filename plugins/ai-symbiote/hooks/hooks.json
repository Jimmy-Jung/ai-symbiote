{
  "description": "ai-symbiote hooks: guard-shell, setup-check, usage-tracker, comment-checker",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}; bash \"$PLUGIN_ROOT/hooks/scripts/setup-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}; bash \"$PLUGIN_ROOT/hooks/scripts/guard-shell.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}; bash \"$PLUGIN_ROOT/hooks/scripts/usage-tracker.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PLUGIN_ROOT=${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}; bash \"$PLUGIN_ROOT/hooks/scripts/comment-checker.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PLUGIN_ROOT=${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}; bash \"$PLUGIN_ROOT/hooks/scripts/messenger-notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
