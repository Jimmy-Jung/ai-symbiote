{
  "description": "ai-symbiote hooks (Cursor): guard-shell, setup-check, pre-compact, usage-tracker, harness-learn, comment-checker, messenger-notify, build-watcher, security-guard, suggest-compact, config-protection, gateguard, mcp-health-check, mcp-health-failure, mcp-health-success",
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/setup-check.sh\"",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/pre-compact.sh\"",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/guard-shell.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/suggest-compact.sh\"",
        "timeout": 5
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/config-protection.sh\"",
        "timeout": 5
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/gateguard-gate.sh\"",
        "timeout": 5
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/mcp-health-check.sh\"",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "matcher": "Shell",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/build-watcher.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Read",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/gateguard-tracker.sh\"",
        "timeout": 5
      },
      {
        "matcher": "Read",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/usage-tracker.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/harness-learn.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/security-guard.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/comment-checker.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/messenger-notify.sh\"",
        "timeout": 10
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/mcp-health-success.sh\"",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/mcp-health-failure.sh\"",
        "timeout": 5
      }
    ]
  }
}
