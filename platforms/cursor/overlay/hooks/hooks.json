{
  "description": "ai-symbiote hooks (Cursor): guard-shell, setup-check, usage-tracker, harness-learn, comment-checker, messenger-notify, build-watcher, security-guard",
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/setup-check.sh\"",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/guard-shell.sh\"",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "matcher": "Shell",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/build-watcher.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Read",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/usage-tracker.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/harness-learn.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/security-guard.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/comment-checker.sh\"",
        "timeout": 10
      },
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/messenger-notify.sh\"",
        "timeout": 10
      }
    ]
  }
}
