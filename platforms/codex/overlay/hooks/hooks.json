{
  "description": "ai-symbiote hooks (Codex CLI): guard-shell, setup-check, pre-edit-write-dispatcher. Note: Codex lacks PostToolUse(Read) and PostToolUseFailure, so gateguard (requires Read tracker) and mcp-health-check (requires failure tracking) are omitted.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${AI_SYMBIOTE_ROOT:-$HOME/plugins/ai-symbiote}/hooks/scripts/setup-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${AI_SYMBIOTE_ROOT:-$HOME/plugins/ai-symbiote}/hooks/scripts/guard-shell.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${AI_SYMBIOTE_ROOT:-$HOME/plugins/ai-symbiote}/hooks/scripts/pre-edit-write-dispatcher.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${AI_SYMBIOTE_ROOT:-$HOME/plugins/ai-symbiote}/hooks/scripts/build-watcher.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
